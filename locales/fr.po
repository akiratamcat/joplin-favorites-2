msgid "Favorites"
msgstr "Favoris"

#: src/panel.ts:54
msgid "Loading panel..."
msgstr "Chargement du panneau..."

#: src/panel.ts:69
msgid "FAVORITES"
msgstr "FAVORIS"

#: src/panel.ts:106
msgid "Rename"
msgstr "Renommer"

#: src/settings.ts:135
msgid "Enable drag & drop of favorites"
msgstr "Activer le glisser-déposer des favoris"

#: src/settings.ts:136
msgid "If enabled, the position of favorites can be change via drag & drop."
msgstr "Si activé, la position des favoris peut être modifiée par glisser-déposer."

#: src/settings.ts:143
msgid "Edit favorite before add"
msgstr "Modifier le favori avant de l'ajouter"

#: src/settings.ts:144
msgid "Opens a dialog to edit the favorite before adding it. If disabled, the name can still be changed later."
msgstr "Ouvre une boîte de dialogue pour modifier le favori avant de l'ajouter. Si désactivé, le nom peut toujours être modifié plus tard."

#: src/settings.ts:151
msgid "Show favorites panel title"
msgstr "Afficher le titre du panneau des favoris"

#: src/settings.ts:152
msgid "Display 'FAVORITES' title in front of the favorites."
msgstr "Affiche le titre « FAVORIS » devant les favoris."

#: src/settings.ts:159
msgid "Show type icons for favorites"
msgstr "Afficher les icônes de type des favoris"

#: src/settings.ts:160
msgid "Display icons before favorite titles representing the types (notebook, note, tag, etc.)."
msgstr "Affiche devant le titre des favoris des icônes représentant leur type (carnet, note, étiquette, etc.)."

#: src/settings.ts:168
msgid "Line height (px)"
msgstr "Hauteur de ligne (px)"

#: src/settings.ts:169
msgid "Line height of the favorites panel."
msgstr "Hauteur de ligne du panneau des favoris."

#: src/settings.ts:176
msgid "Minimum favorite width (px)"
msgstr "Largeur minimale d'un favori (px)"

#: src/settings.ts:177
msgid "Minimum width of one favorite in pixel."
msgstr "Largeur minimale d'un favori en pixels."

#: src/settings.ts:184
msgid "Maximum favorite width (px)"
msgstr "Largeur maximale d'un favori (px)"

#: src/settings.ts:185
msgid "Maximum width of one favorite in pixel."
msgstr "Largeur maximale d'un favori en pixels."

#: src/settings.ts:195
msgid "Font family"
msgstr "Police"

#: src/settings.ts:196
msgid "Font family used in the panel. Font families other than 'default' must be installed on the system. If the font is incorrect or empty, it might default to a generic sans-serif font. (default: App default)"
msgstr "Police utilisée dans le panneau. Les polices autres que 'default' doivent être installées sur le système. Si la police est incorrecte ou vide, une police sans-serif générique peut être utilisée. (par défaut : police de l'application)"

#: src/settings.ts:204
msgid "Font size"
msgstr "Taille de police"

#: src/settings.ts:205
msgid "Font size used in the panel. Values other than 'default' must be specified in valid CSS syntax, e.g. '13px'. (default: App default font size)"
msgstr "Taille de police utilisée dans le panneau. Les valeurs autres que 'default' doivent respecter la syntaxe CSS, par ex. '13px'. (par défaut : taille de police de l'application)"

#: src/settings.ts:213
msgid "Background color"
msgstr "Couleur d'arrière-plan"

#: src/settings.ts:214
msgid "Main background color of the panel. (default: Note list background color)"
msgstr "Couleur d'arrière-plan principale du panneau. (par défaut : couleur d'arrière-plan de la liste des notes)"

#: src/settings.ts:222
msgid "Hover Background color"
msgstr "Couleur d'arrière-plan au survol"

#: src/settings.ts:223
msgid "Background color used when hovering a favorite. (default: Note list hover color)"
msgstr "Couleur d'arrière-plan lors du survol d'un favori. (par défaut : couleur de survol de la liste des notes)"

#: src/settings.ts:231
msgid "Foreground color"
msgstr "Couleur de premier plan"

#: src/settings.ts:232
msgid "Foreground color used for text and icons. (default: App faded color)"
msgstr "Couleur du texte et des icônes. (par défaut : couleur atténuée de l'application)"

#: src/settings.ts:240
msgid "Divider color"
msgstr "Couleur du séparateur"

#: src/settings.ts:241
msgid "Color of the divider between the favorites. (default: App default border color)"
msgstr "Couleur du séparateur entre les favoris. (par défaut : couleur de bordure de l'application)"
