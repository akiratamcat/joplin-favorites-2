#: src/panel.ts:54
msgid "Loading panel..."
msgstr "Cargando panel..."

#: src/panel.ts:69
msgid "FAVORITES"
msgstr "FAVORITOS"

#: src/panel.ts:106
msgid "Rename"
msgstr "Renombrar"

#: src/settings.ts:135
msgid "Enable drag & drop of favorites"
msgstr "Habilitar arrastrar y soltar favoritos"

#: src/settings.ts:136
msgid "If enabled, the position of favorites can be change via drag & drop."
msgstr "Si está habilitado, la posición de los favoritos puede cambiarse arrastrando y soltando."

#: src/settings.ts:143
msgid "Edit favorite before add"
msgstr "Editar el favorito antes de añadirlo"

#: src/settings.ts:144
msgid "Opens a dialog to edit the favorite before adding it. If disabled, the name can still be changed later."
msgstr "Abre un diálogo para editar el favorito antes de añadirlo. Si está deshabilitado, el nombre se puede cambiar más tarde."

#: src/settings.ts:151
msgid "Show favorites panel title"
msgstr "Mostrar el título del panel de favoritos"

#: src/settings.ts:152
msgid "Display 'FAVORITES' title in front of the favorites."
msgstr "Muestra el título «FAVORITOS» delante de los favoritos."

#: src/settings.ts:159
msgid "Show type icons for favorites"
msgstr "Mostrar iconos de tipo en los favoritos"

#: src/settings.ts:160
msgid "Display icons before favorite titles representing the types (notebook, note, tag, etc.)."
msgstr "Muestra iconos delante de los títulos de los favoritos que representan su tipo (libreta, nota, etiqueta, etc.)."

#: src/settings.ts:168
msgid "Line height (px)"
msgstr "Altura de línea (px)"

#: src/settings.ts:169
msgid "Line height of the favorites panel."
msgstr "Altura de línea del panel de favoritos."

#: src/settings.ts:176
msgid "Minimum favorite width (px)"
msgstr "Ancho mínimo del favorito (px)"

#: src/settings.ts:177
msgid "Minimum width of one favorite in pixel."
msgstr "Ancho mínimo de un favorito en píxeles."

#: src/settings.ts:184
msgid "Maximum favorite width (px)"
msgstr "Ancho máximo del favorito (px)"

#: src/settings.ts:185
msgid "Maximum width of one favorite in pixel."
msgstr "Ancho máximo de un favorito en píxeles."

#: src/settings.ts:195
msgid "Font family"
msgstr "Fuente"

#: src/settings.ts:196
msgid "Font family used in the panel. Font families other than 'default' must be installed on the system. If the font is incorrect or empty, it might default to a generic sans-serif font. (default: App default)"
msgstr "Fuente utilizada en el panel. Las fuentes distintas de 'default' deben estar instaladas en el sistema. Si la fuente es incorrecta o está vacía, puede usarse una fuente sans-serif genérica. (predeterminado: fuente de la aplicación)"

#: src/settings.ts:204
msgid "Font size"
msgstr "Tamaño de fuente"

#: src/settings.ts:205
msgid "Font size used in the panel. Values other than 'default' must be specified in valid CSS syntax, e.g. '13px'. (default: App default font size)"
msgstr "Tamaño de fuente utilizado en el panel. Los valores distintos de 'default' deben indicarse con sintaxis CSS válida, p. ej. '13px'. (predeterminado: tamaño de fuente de la aplicación)"

#: src/settings.ts:213
msgid "Background color"
msgstr "Color de fondo"

#: src/settings.ts:214
msgid "Main background color of the panel. (default: Note list background color)"
msgstr "Color de fondo principal del panel. (predeterminado: color de fondo de la lista de notas)"

#: src/settings.ts:222
msgid "Hover Background color"
msgstr "Color de fondo al pasar el ratón"

#: src/settings.ts:223
msgid "Background color used when hovering a favorite. (default: Note list hover color)"
msgstr "Color de fondo al pasar el ratón sobre un favorito. (predeterminado: color de resaltado de la lista de notas)"

#: src/settings.ts:231
msgid "Foreground color"
msgstr "Color de primer plano"

#: src/settings.ts:232
msgid "Foreground color used for text and icons. (default: App faded color)"
msgstr "Color usado para el texto y los iconos. (predeterminado: color atenuado de la aplicación)"

#: src/settings.ts:240
msgid "Divider color"
msgstr "Color del separador"

#: src/settings.ts:241
msgid "Color of the divider between the favorites. (default: App default border color)"
msgstr "Color del separador entre los favoritos. (predeterminado: color de borde de la aplicación)"
