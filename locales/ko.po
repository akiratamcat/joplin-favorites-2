msgid "Add active notebook"
msgstr "현재 노트북 추가"

#: src/index.ts:312
msgid "Add selected note(s)"
msgstr "선택한 노트 추가"

#: src/index.ts:316
msgid "Add new search"
msgstr "새 검색 추가"

#: src/index.ts:328
msgid "Toggle panel visibility"
msgstr "패널 표시 전환"

#: src/index.ts:344 src/settings.ts:117 src/settings.ts:127
msgid "Favorites"
msgstr "즐겨찾기"

#: src/panel.ts:54
msgid "Loading panel..."
msgstr "패널 불러오는 중..."

#: src/panel.ts:69
msgid "FAVORITES"
msgstr "즐겨찾기"

#: src/panel.ts:106
msgid "Rename"
msgstr "이름 바꾸기"

#: src/settings.ts:135
msgid "Enable drag & drop of favorites"
msgstr "즐겨찾기 드래그 앤 드롭 사용"

#: src/settings.ts:136
msgid "If enabled, the position of favorites can be change via drag & drop."
msgstr "사용하면 드래그 앤 드롭으로 즐겨찾기의 위치를 변경할 수 있습니다."

#: src/settings.ts:143
msgid "Edit favorite before add"
msgstr "추가하기 전에 즐겨찾기 편집"

#: src/settings.ts:144
msgid "Opens a dialog to edit the favorite before adding it. If disabled, the name can still be changed later."
msgstr "즐겨찾기를 추가하기 전에 편집 대화 상자를 엽니다. 사용하지 않아도 이름은 나중에 변경할 수 있습니다."

#: src/settings.ts:151
msgid "Show favorites panel title"
msgstr "즐겨찾기 패널 제목 표시"

#: src/settings.ts:152
msgid "Display 'FAVORITES' title in front of the favorites."
msgstr "즐겨찾기 앞에 '즐겨찾기' 제목을 표시합니다."

#: src/settings.ts:159
msgid "Show type icons for favorites"
msgstr "즐겨찾기 유형 아이콘 표시"

#: src/settings.ts:160
msgid "Display icons before favorite titles representing the types (notebook, note, tag, etc.)."
msgstr "즐겨찾기 제목 앞에 유형(노트북, 노트, 태그 등)을 나타내는 아이콘을 표시합니다."

#: src/settings.ts:168
msgid "Line height (px)"
msgstr "줄 높이 (px)"

#: src/settings.ts:169
msgid "Line height of the favorites panel."
msgstr "즐겨찾기 패널의 줄 높이입니다."

#: src/settings.ts:176
msgid "Minimum favorite width (px)"
msgstr "즐겨찾기 최소 너비 (px)"

#: src/settings.ts:177
msgid "Minimum width of one favorite in pixel."
msgstr "즐겨찾기 하나의 최소 너비(픽셀)입니다."

#: src/settings.ts:184
msgid "Maximum favorite width (px)"
msgstr "즐겨찾기 최대 너비 (px)"

#: src/settings.ts:185
msgid "Maximum width of one favorite in pixel."
msgstr "즐겨찾기 하나의 최대 너비(픽셀)입니다."

#: src/settings.ts:195
msgid "Font family"
msgstr "글꼴"

#: src/settings.ts:196
msgid "Font family used in the panel. Font families other than 'default' must be installed on the system. If the font is incorrect or empty, it might default to a generic sans-serif font. (default: App default)"
msgstr "패널에서 사용할 글꼴입니다. 'default' 이외의 글꼴은 시스템에 설치되어 있어야 합니다. 글꼴이 올바르지 않거나 비어 있으면 일반 sans-serif 글꼴이 사용될 수 있습니다. (기본값: 앱 기본값)"

#: src/settings.ts:204
msgid "Font size"
msgstr "글꼴 크기"

#: src/settings.ts:205
msgid "Font size used in the panel. Values other than 'default' must be specified in valid CSS syntax, e.g. '13px'. (default: App default font size)"
msgstr "패널에서 사용할 글꼴 크기입니다. 'default' 이외의 값은 '13px'처럼 올바른 CSS 구문으로 지정해야 합니다. (기본값: 앱 기본 글꼴 크기)"

#: src/settings.ts:213
msgid "Background color"
msgstr "배경색"

#: src/settings.ts:214
msgid "Main background color of the panel. (default: Note list background color)"
msgstr "패널의 기본 배경색입니다. (기본값: 노트 목록 배경색)"

#: src/settings.ts:222
msgid "Hover Background color"
msgstr "마우스 오버 배경색"

#: src/settings.ts:223
msgid "Background color used when hovering a favorite. (default: Note list hover color)"
msgstr "즐겨찾기에 마우스를 올렸을 때의 배경색입니다. (기본값: 노트 목록 마우스 오버 색)"

#: src/settings.ts:231
msgid "Foreground color"
msgstr "전경색"

#: src/settings.ts:232
msgid "Foreground color used for text and icons. (default: App faded color)"
msgstr "텍스트와 아이콘에 사용할 색입니다. (기본값: 앱 흐린 색)"

#: src/settings.ts:240
msgid "Divider color"
msgstr "구분선 색"

#: src/settings.ts:241
msgid "Color of the divider between the favorites. (default: App default border color)"
msgstr "즐겨찾기 사이 구분선의 색입니다. (기본값: 앱 기본 테두리 색)"
