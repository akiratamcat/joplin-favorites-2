#: src/index.ts:344 src/settings.ts:117 src/settings.ts:127
msgid "Favorites"
msgstr "Preferiti"

#: src/panel.ts:54
msgid "Loading panel..."
msgstr "Caricamento pannello..."

#: src/panel.ts:69
msgid "FAVORITES"
msgstr "PREFERITI"

#: src/panel.ts:106
msgid "Rename"
msgstr "Rinomina"

#: src/settings.ts:135
msgid "Enable drag & drop of favorites"
msgstr "Abilita trascinamento dei preferiti"

#: src/settings.ts:136
msgid "If enabled, the position of favorites can be change via drag & drop."
msgstr "Se abilitato, la posizione dei preferiti può essere modificata tramite trascinamento."

#: src/settings.ts:143
msgid "Edit favorite before add"
msgstr "Modifica il preferito prima di aggiungerlo"

#: src/settings.ts:144
msgid "Opens a dialog to edit the favorite before adding it. If disabled, the name can still be changed later."
msgstr "Apre una finestra per modificare il preferito prima di aggiungerlo. Se disabilitato, il nome può comunque essere modificato in seguito."

#: src/settings.ts:151
msgid "Show favorites panel title"
msgstr "Mostra il titolo del pannello dei preferiti"

#: src/settings.ts:152
msgid "Display 'FAVORITES' title in front of the favorites."
msgstr "Mostra il titolo «PREFERITI» davanti ai preferiti."

#: src/settings.ts:159
msgid "Show type icons for favorites"
msgstr "Mostra le icone del tipo dei preferiti"

#: src/settings.ts:160
msgid "Display icons before favorite titles representing the types (notebook, note, tag, etc.)."
msgstr "Mostra davanti ai titoli dei preferiti delle icone che ne rappresentano il tipo (taccuino, nota, etichetta, ecc.)."

#: src/settings.ts:168
msgid "Line height (px)"
msgstr "Altezza riga (px)"

#: src/settings.ts:169
msgid "Line height of the favorites panel."
msgstr "Altezza riga del pannello dei preferiti."

#: src/settings.ts:176
msgid "Minimum favorite width (px)"
msgstr "Larghezza minima del preferito (px)"

#: src/settings.ts:177
msgid "Minimum width of one favorite in pixel."
msgstr "Larghezza minima di un preferito in pixel."

#: src/settings.ts:184
msgid "Maximum favorite width (px)"
msgstr "Larghezza massima del preferito (px)"

#: src/settings.ts:185
msgid "Maximum width of one favorite in pixel."
msgstr "Larghezza massima di un preferito in pixel."

#: src/settings.ts:195
msgid "Font family"
msgstr "Carattere"

#: src/settings.ts:196
msgid "Font family used in the panel. Font families other than 'default' must be installed on the system. If the font is incorrect or empty, it might default to a generic sans-serif font. (default: App default)"
msgstr "Carattere usato nel pannello. I caratteri diversi da 'default' devono essere installati nel sistema. Se il carattere non è corretto o è vuoto, potrebbe essere usato un carattere sans-serif generico. (predefinito: carattere dell'app)"

#: src/settings.ts:204
msgid "Font size"
msgstr "Dimensione carattere"

#: src/settings.ts:205
msgid "Font size used in the panel. Values other than 'default' must be specified in valid CSS syntax, e.g. '13px'. (default: App default font size)"
msgstr "Dimensione del carattere usata nel pannello. I valori diversi da 'default' devono essere specificati con una sintassi CSS valida, ad es. '13px'. (predefinito: dimensione del carattere dell'app)"

#: src/settings.ts:213
msgid "Background color"
msgstr "Colore di sfondo"

#: src/settings.ts:214
msgid "Main background color of the panel. (default: Note list background color)"
msgstr "Colore di sfondo principale del pannello. (predefinito: colore di sfondo dell'elenco note)"

#: src/settings.ts:222
msgid "Hover Background color"
msgstr "Colore di sfondo al passaggio del mouse"

#: src/settings.ts:223
msgid "Background color used when hovering a favorite. (default: Note list hover color)"
msgstr "Colore di sfondo al passaggio del mouse su un preferito. (predefinito: colore di evidenziazione dell'elenco note)"

#: src/settings.ts:231
msgid "Foreground color"
msgstr "Colore di primo piano"

#: src/settings.ts:232
msgid "Foreground color used for text and icons. (default: App faded color)"
msgstr "Colore usato per testo e icone. (predefinito: colore attenuato dell'app)"

#: src/settings.ts:240
msgid "Divider color"
msgstr "Colore del divisore"

#: src/settings.ts:241
msgid "Color of the divider between the favorites. (default: App default border color)"
msgstr "Colore del divisore tra i preferiti. (predefinito: colore del bordo dell'app)"
