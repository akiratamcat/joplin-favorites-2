msgid "Favorites"
msgstr "我的最愛"

#: src/panel.ts:54
msgid "Loading panel..."
msgstr "正在載入面板..."

#: src/panel.ts:69
msgid "FAVORITES"
msgstr "我的最愛"

#: src/panel.ts:106
msgid "Rename"
msgstr "重新命名"

#: src/settings.ts:135
msgid "Enable drag & drop of favorites"
msgstr "啟用我的最愛拖放"

#: src/settings.ts:136
msgid "If enabled, the position of favorites can be change via drag & drop."
msgstr "啟用後，可透過拖放變更我的最愛的位置。"

#: src/settings.ts:143
msgid "Edit favorite before add"
msgstr "新增前編輯我的最愛"

#: src/settings.ts:144
msgid "Opens a dialog to edit the favorite before adding it. If disabled, the name can still be changed later."
msgstr "新增我的最愛前開啟編輯對話框。若停用，之後仍可變更名稱。"

#: src/settings.ts:151
msgid "Show favorites panel title"
msgstr "顯示我的最愛面板標題"

#: src/settings.ts:152
msgid "Display 'FAVORITES' title in front of the favorites."
msgstr "在我的最愛前顯示「我的最愛」標題。"

#: src/settings.ts:159
msgid "Show type icons for favorites"
msgstr "顯示我的最愛類型圖示"

#: src/settings.ts:160
msgid "Display icons before favorite titles representing the types (notebook, note, tag, etc.)."
msgstr "在我的最愛標題前顯示代表類型（筆記本、筆記、標籤等）的圖示。"

#: src/settings.ts:168
msgid "Line height (px)"
msgstr "行高 (px)"

#: src/settings.ts:169
msgid "Line height of the favorites panel."
msgstr "我的最愛面板的行高。"

#: src/settings.ts:176
msgid "Minimum favorite width (px)"
msgstr "我的最愛最小寬度 (px)"

#: src/settings.ts:177
msgid "Minimum width of one favorite in pixel."
msgstr "單一我的最愛的最小寬度（像素）。"

#: src/settings.ts:184
msgid "Maximum favorite width (px)"
msgstr "我的最愛最大寬度 (px)"

#: src/settings.ts:185
msgid "Maximum width of one favorite in pixel."
msgstr "單一我的最愛的最大寬度（像素）。"

#: src/settings.ts:195
msgid "Font family"
msgstr "字型"

#: src/settings.ts:196
msgid "Font family used in the panel. Font families other than 'default' must be installed on the system. If the font is incorrect or empty, it might default to a generic sans-serif font. (default: App default)"
msgstr "面板中使用的字型。'default' 以外的字型必須已安裝在系統中。若字型不正確或為空白，可能會使用通用的 sans-serif 字型。（預設：應用程式預設）"

#: src/settings.ts:204
msgid "Font size"
msgstr "字型大小"

#: src/settings.ts:205
msgid "Font size used in the panel. Values other than 'default' must be specified in valid CSS syntax, e.g. '13px'. (default: App default font size)"
msgstr "面板中使用的字型大小。'default' 以外的值必須以有效的 CSS 語法指定，例如 '13px'。（預設：應用程式預設字型大小）"

#: src/settings.ts:213
msgid "Background color"
msgstr "背景顏色"

#: src/settings.ts:214
msgid "Main background color of the panel. (default: Note list background color)"
msgstr "面板的主要背景顏色。（預設：筆記清單背景顏色）"

#: src/settings.ts:222
msgid "Hover Background color"
msgstr "滑鼠懸停背景顏色"

#: src/settings.ts:223
msgid "Background color used when hovering a favorite. (default: Note list hover color)"
msgstr "滑鼠懸停在我的最愛上時的背景顏色。（預設：筆記清單懸停顏色）"

#: src/settings.ts:231
msgid "Foreground color"
msgstr "前景顏色"

#: src/settings.ts:232
msgid "Foreground color used for text and icons. (default: App faded color)"
msgstr "文字與圖示使用的顏色。（預設：應用程式淡色）"

#: src/settings.ts:240
msgid "Divider color"
msgstr "分隔線顏色"

#: src/settings.ts:241
msgid "Color of the divider between the favorites. (default: App default border color)"
msgstr "我的最愛之間分隔線的顏色。（預設：應用程式預設邊框顏色）"
