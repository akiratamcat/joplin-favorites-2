#: src/index.ts:344 src/settings.ts:117 src/settings.ts:127
msgid "Favorites"
msgstr "お気に入り"

#: src/panel.ts:54
msgid "Loading panel..."
msgstr "パネルを読み込み中..."

#: src/panel.ts:69
msgid "FAVORITES"
msgstr "お気に入り"

#: src/panel.ts:106
msgid "Rename"
msgstr "名前を変更"

#: src/settings.ts:135
msgid "Enable drag & drop of favorites"
msgstr "お気に入りのドラッグ＆ドロップを有効にする"

#: src/settings.ts:136
msgid "If enabled, the position of favorites can be change via drag & drop."
msgstr "有効にすると、ドラッグ＆ドロップでお気に入りの並び順を変更できます。"

#: src/settings.ts:143
msgid "Edit favorite before add"
msgstr "追加する前にお気に入りを編集する"

#: src/settings.ts:144
msgid "Opens a dialog to edit the favorite before adding it. If disabled, the name can still be changed later."
msgstr "お気に入りを追加する前に編集ダイアログを開きます。無効にした場合でも、名前は後から変更できます。"

#: src/settings.ts:151
msgid "Show favorites panel title"
msgstr "お気に入りパネルのタイトルを表示する"

#: src/settings.ts:152
msgid "Display 'FAVORITES' title in front of the favorites."
msgstr "お気に入りの先頭に「お気に入り」というタイトルを表示します。"

#: src/settings.ts:159
msgid "Show type icons for favorites"
msgstr "お気に入りの種類アイコンを表示する"

#: src/settings.ts:160
msgid "Display icons before favorite titles representing the types (notebook, note, tag, etc.)."
msgstr "お気に入りの名前の前に、種類（ノートブック、ノート、タグなど）を表すアイコンを表示します。"

#: src/settings.ts:168
msgid "Line height (px)"
msgstr "行の高さ (px)"

#: src/settings.ts:169
msgid "Line height of the favorites panel."
msgstr "お気に入りパネルの行の高さです。"

#: src/settings.ts:176
msgid "Minimum favorite width (px)"
msgstr "お気に入りの最小幅 (px)"

#: src/settings.ts:177
msgid "Minimum width of one favorite in pixel."
msgstr "お気に入り1件あたりの最小幅（ピクセル）です。"

#: src/settings.ts:184
msgid "Maximum favorite width (px)"
msgstr "お気に入りの最大幅 (px)"

#: src/settings.ts:185
msgid "Maximum width of one favorite in pixel."
msgstr "お気に入り1件あたりの最大幅（ピクセル）です。"

#: src/settings.ts:195
msgid "Font family"
msgstr "フォント"

#: src/settings.ts:196
msgid "Font family used in the panel. Font families other than 'default' must be installed on the system. If the font is incorrect or empty, it might default to a generic sans-serif font. (default: App default)"
msgstr "パネルで使用するフォントです。'default' 以外のフォントはシステムにインストールされている必要があります。フォント名が正しくないか空の場合は、一般的な sans-serif フォントになることがあります。（既定値: アプリの既定）"

#: src/settings.ts:204
msgid "Font size"
msgstr "フォントサイズ"

#: src/settings.ts:205
msgid "Font size used in the panel. Values other than 'default' must be specified in valid CSS syntax, e.g. '13px'. (default: App default font size)"
msgstr "パネルで使用するフォントサイズです。'default' 以外の値は、'13px' のように正しい CSS 構文で指定してください。（既定値: アプリの既定のフォントサイズ）"

#: src/settings.ts:213
msgid "Background color"
msgstr "背景色"

#: src/settings.ts:214
msgid "Main background color of the panel. (default: Note list background color)"
msgstr "パネルのメインの背景色です。（既定値: ノート一覧の背景色）"

#: src/settings.ts:222
msgid "Hover Background color"
msgstr "ホバー時の背景色"

#: src/settings.ts:223
msgid "Background color used when hovering a favorite. (default: Note list hover color)"
msgstr "お気に入りにマウスを重ねたときの背景色です。（既定値: ノート一覧のホバー色）"

#: src/settings.ts:231
msgid "Foreground color"
msgstr "前景色"

#: src/settings.ts:232
msgid "Foreground color used for text and icons. (default: App faded color)"
msgstr "文字とアイコンに使用する色です。（既定値: アプリの淡色）"

#: src/settings.ts:240
msgid "Divider color"
msgstr "区切り線の色"

#: src/settings.ts:241
msgid "Color of the divider between the favorites. (default: App default border color)"
msgstr "お気に入り同士の区切り線の色です。（既定値: アプリの既定の境界線の色）"
